# Backend (Supabase) — copy to .env and fill in your own project values.
# Never commit real credentials.

# Server-side
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Service-role key: server-side only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY
# Legacy alias (optional): some older Supabase projects still use this name.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# Client-side (Vite exposes only VITE_* to the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Google Drive (Server-side only, do not prefix with VITE_)
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "..."}
MEDIA_CLUB_DRIVE_ROOT_ID=YOUR_ROOT_FOLDER_ID
EVENTS_DRIVE_FOLDER_ID=YOUR_EVENTS_FOLDER_ID
HIGHLIGHTS_DRIVE_FOLDER_ID=YOUR_HIGHLIGHTS_FOLDER_ID
NEWS_DRIVE_FOLDER_ID=YOUR_NEWS_FOLDER_ID
TEAM_DRIVE_FOLDER_ID=YOUR_TEAM_FOLDER_ID
SITE_ASSETS_DRIVE_FOLDER_ID=YOUR_SITE_ASSETS_FOLDER_ID

# Creator Mode (Server-side only — never expose the password to the browser)
# CREATOR_PASSWORD is verified server-side on every unlock attempt.
CREATOR_PASSWORD=your-strong-creator-password
# CREATOR_SESSION_SECRET must be >= 32 characters for cookie signing.
CREATOR_SESSION_SECRET=a-very-long-random-secret-at-least-32-chars-long

